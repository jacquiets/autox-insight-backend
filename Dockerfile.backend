FROM python:3.12-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS runner
WORKDIR /app

LABEL org.opencontainers.image.title="AutoX Insight — Backend"
LABEL org.opencontainers.image.description="FastAPI + XGBoost backend para bpA Motors SCM Intelligence"
LABEL org.opencontainers.image.source="https://github.com/jacquiets/autox-insight-backend"
LABEL org.opencontainers.image.licenses="MIT"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 curl && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --no-create-home --uid 1001 appuser

COPY --from=builder /install /usr/local
COPY app/ app/
COPY ml/ ml/

RUN mkdir -p /app/ml && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
